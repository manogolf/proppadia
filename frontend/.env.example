VITE_API_BASE=http://localhost:8001

# Frontend auth keys only (never use service-role key in frontend env).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional legacy fallback if you use anon naming:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Auth UI/runtime controls
# Use your production site url in prod env, local url in local env.
VITE_AUTH_REDIRECT_TO=http://localhost:3000/

# Login methods
VITE_AUTH_ENABLE_PASSWORD_LOGIN=true
VITE_AUTH_ENABLE_MAGIC_LINK=true

# If false, magic links work only for existing users (no auto-create).
VITE_AUTH_MAGIC_CREATE_USER=false

# Comma-separated list from: google,apple,github
VITE_AUTH_OAUTH_PROVIDERS=google

# Optional ops access allow-list (frontend route gating only)
# VITE_OPS_ALLOWED_EMAILS=you@example.com
# VITE_OPS_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000
