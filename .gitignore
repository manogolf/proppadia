# ── OS / editor junk ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
.history/
*.log
*.swp
*.swo
*.orig
*.rej
*.tmp
*.bak
*.backup
*/._*

# ── Node / JS projects (CRA/Vite/any subpackage) ───────────────────
**/node_modules/
**/dist/
**/build/
.eslintcache
coverage/
*.local
# Vite cache
**/node_modules/.vite/
.vite/

# ── Env files (NEVER commit secrets) ───────────────────────────────
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
db_url.txt

# ── Python ─────────────────────────────────────────────────────────
.venv/
venv/
**/.venv/
**/venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
**/.pytest_cache/
.ipynb_checkpoints/

# ── Data / exports / reports (keep templates) ──────────────────────
exports/
logs/
reports/**
nhl/data/raw/
nhl/data/interim/
nhl/data/processed/*.csv
mlb/data/raw/
mlb/data/interim/
mlb/data/processed/*.csv
data/**
!data/import_templates/**
!data/README.md

# ── Models / artifacts (ignore bulk; keep minimal metadata) ────────
backend/nhl/models/**
!backend/nhl/models/
!backend/nhl/models/latest/
!backend/nhl/models/latest/**/
!backend/nhl/models/latest/**/MODEL_INDEX.json
!backend/nhl/models/latest/**/FEATURE_HASH.txt
!backend/nhl/models/latest/**/MODEL_ARTIFACT.json

backend/mlb/models/archive/
backend/mlb/models/latest/*.pkl
models_out/
*.joblib
*.pkl

# ── Legacy CRA subprojects that may linger ─────────────────────────
mlb/backend/node_modules/
mlb/backend/build/
mlb/frontend/node_modules/
mlb/frontend/build/

# ── Repo-local runtime debris ───────────────────────────────────────
backend/nhl/venv/
backend/nhl/logs/
backend/nhl/exports/
backend/nhl/_debug_dumps/
nhl_daily_LAST_FAIL.txt
nhl_daily_STATUS.txt
