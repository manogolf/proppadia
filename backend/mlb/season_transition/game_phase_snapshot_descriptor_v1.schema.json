{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MLB_2026_VERSIONED_FILE_PHASE_AUTHORITY_DESCRIPTOR_V1",
  "additionalProperties": false,
  "properties": {
    "builder_contract": {"const": "MLB_2026_VERSIONED_FILE_PHASE_AUTHORITY_BUILDER_V1"},
    "builder_version": {"const": "1"},
    "classification_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "contract_name": {"const": "MLB_2026_VERSIONED_FILE_PHASE_AUTHORITY_V1"},
    "deterministic_source_set_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "distinct_game_pk_count": {"minimum": 0, "type": "integer"},
    "game_pk_population_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "normalized_phase_counts": {"additionalProperties": {"minimum": 0, "type": "integer"}, "type": "object"},
    "parent_descriptor_path": {"type": ["string", "null"]},
    "parent_descriptor_sha256": {"type": ["string", "null"]},
    "parent_snapshot_id": {"type": ["string", "null"]},
    "proposal_path": {"minLength": 1, "type": "string"},
    "proposal_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "raw_game_type_counts": {"additionalProperties": {"minimum": 0, "type": "integer"}, "type": "object"},
    "root_snapshot_id": {"minLength": 1, "type": "string"},
    "row_count": {"minimum": 0, "type": "integer"},
    "scheduled_date_from": {"format": "date", "type": "string"},
    "scheduled_date_through": {"format": "date", "type": "string"},
    "schema_version": {"const": 1},
    "snapshot_id": {"minLength": 1, "type": "string"},
    "snapshot_status": {"enum": ["CANDIDATE", "GOVERNED"]},
    "source_file_count": {"minimum": 0, "type": "integer"},
    "source_manifest_path": {"minLength": 1, "type": "string"},
    "source_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source_observation_count": {"minimum": 0, "type": "integer"},
    "supported_season": {"const": 2026},
    "v1_authority_records_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "v1_proposal_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "v1_source_manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "contract_name", "schema_version", "snapshot_id", "root_snapshot_id",
    "snapshot_status", "proposal_path", "proposal_sha256",
    "source_manifest_path", "source_manifest_sha256", "parent_descriptor_path",
    "parent_descriptor_sha256", "parent_snapshot_id", "row_count",
    "distinct_game_pk_count", "raw_game_type_counts", "normalized_phase_counts",
    "supported_season", "scheduled_date_from", "scheduled_date_through",
    "builder_contract", "builder_version", "deterministic_source_set_sha256",
    "source_file_count", "source_observation_count", "game_pk_population_sha256",
    "classification_sha256", "v1_proposal_sha256", "v1_source_manifest_sha256",
    "v1_authority_records_sha256"
  ],
  "title": "MLB 2026 versioned file phase authority descriptor V1",
  "type": "object"
}
