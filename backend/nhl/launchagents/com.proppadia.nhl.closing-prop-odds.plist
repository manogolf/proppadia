  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>/Users/jerrystrain/Projects/proppadia/artifacts/operational/nhl/odds_observations/closing_launchagent.stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/jerrystrain/Projects/proppadia/artifacts/operational/nhl/odds_observations/closing_launchagent.stderr.log</string>
</dict>
</plist>
